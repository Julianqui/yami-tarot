# ───────── Mercado Pago ─────────
# Access token de la cuenta de Yami (Mercado Pago → Tus integraciones → Credenciales).
# Empezá con el de PRUEBA (TEST-...) y cambialo por el de producción (APP_USR-...) al publicar.
MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxx-xxxxxxxxx
# Clave secreta del webhook (Mercado Pago → Webhooks → "Firma secreta"). Opcional en desarrollo.
MP_WEBHOOK_SECRET=

# URL pública del sitio. En local dejalo vacío; en producción: https://yamitarot.com
NEXT_PUBLIC_SITE_URL=

# ───────── Videoteca ─────────
# En Vercel: se crea sola al conectar un store de Blob al proyecto.
# En local no hace falta (los videos se guardan en public/uploads).
BLOB_READ_WRITE_TOKEN=

# ───────── Panel de videos ─────────
ADMIN_PASSWORD=cambiame
ADMIN_SECRET=texto-largo-y-aleatorio-para-firmar-la-sesion
MAX_UPLOAD_MB=500

# ───────── Contacto (se muestran en el sitio) ─────────
NEXT_PUBLIC_WHATSAPP=5491122334455
NEXT_PUBLIC_INSTAGRAM=yami.tarot
NEXT_PUBLIC_EMAIL=hola@yamitarot.com
